<div class="cel-root"><aside class="cel-sidebar" aria-label="Ledger navigation"><div class="cel-brand"><img src="modules/cypher-enterprise-ledger/assets/brand.svg" alt="" width="34" height="34"><div><strong>ENTERPRISE</strong><small>Cypher System</small></div></div><nav class="cel-tabs">{{#each navItems}}{{#if group}}<span class="nav-group">{{group}}</span>{{/if}}<button type="button" data-action="celShowTab" data-tab="{{id}}" aria-label="{{label}}" title="{{label}}" class="{{#if active}}active{{/if}}" {{#if active}}aria-current="page"{{/if}}><i class="fa-solid fa-{{icon}}" aria-hidden="true"></i><span>{{label}}</span>{{#if active}}<span class="nav-dot"></span>{{/if}}</button>{{/each}}</nav><div class="sidebar-foot"><span class="live-dot"></span>{{#if isGM}}GM workspace{{else}}Player workspace{{/if}}<small>v{{version}}</small></div></aside>
<div class="cel-workspace"><header class="cel-header {{#if banner}}has-banner{{/if}}" {{#if banner}}style="--banner:url('{{banner}}')"{{/if}}><div class="cel-heading"><span class="theme-emblem" aria-hidden="true"></span><p class="eyebrow">Enterprise Ledger / {{pageTitle}}</p><h1>{{#if isGM}}<input class="cel-title-in" aria-label="Company name" data-edit="business" data-field="name" value="{{state.name}}">{{else}}{{state.name}}{{/if}}</h1><p class="muted">Your company. Every decision, connected.</p></div><div class="cel-badges"><span class="badge"><small>MONTH</small><b>{{state.month}}</b></span><span class="badge"><small>RANK</small>{{#if isGM}}<input type="number" aria-label="Company rank" min="1" max="10" data-edit="business" data-field="level" value="{{state.level}}">{{else}}<b>{{state.level}}</b>{{/if}}</span><button class="icon-btn" type="button" data-action="celSettings" aria-label="Ledger settings" title="Settings"><i class="fa-solid fa-sliders"></i></button></div></header>
<section class="cel-body" aria-label="{{pageTitle}}"><div class="page-heading"><div><p class="eyebrow">COMPANY INTELLIGENCE</p><h2>{{pageTitle}}</h2></div><span class="badge">{{#if isGM}}Full access{{else}}Read &amp; participate{{/if}}</span></div>
{{#if tabs.overview}}<div class="metric-grid"><article class="metric"><div class="metric-top"><span>Treasury</span><i class="fa-solid fa-wallet"></i></div>{{#if isGM}}<input class="metric-value" aria-label="Treasury" type="number" data-edit="business" data-field="cash" value="{{state.cash}}">{{else}}<b class="metric-value" data-count="{{state.cash}}" data-ck="cash">{{state.cash}}</b>{{/if}}<small>Ledger coins · available funds</small><div class="metric-line violet"></div></article><article class="metric"><div class="metric-top"><span>Monthly income</span><i class="fa-solid fa-arrow-trend-up"></i></div><b class="metric-value" data-count="{{f.income}}" data-ck="income">{{f.income}}</b><small>Projected at month close</small><div class="metric-line"></div></article><article class="metric"><div class="metric-top"><span>Operating costs</span><i class="fa-solid fa-receipt"></i></div><b class="metric-value" data-count="{{f.costs}}" data-ck="costs">{{f.costs}}</b><small>Wages, upkeep &amp; operations</small><div class="metric-line amber"></div></article><article class="metric {{#if (gte f.profit 0)}}positive{{else}}negative{{/if}}"><div class="metric-top"><span>Net profit</span><i class="fa-solid fa-chart-simple"></i></div><b class="metric-value" data-count="{{f.profit}}" data-ck="profit">{{f.profit}}</b><small>Projected · income less costs</small><div class="metric-line"></div></article></div>
<div class="dashboard-grid"><article class="cel-panel trend"><div class="panel-heading"><div><p class="eyebrow">PERFORMANCE</p><h3>Profit history</h3></div><span class="badge">Last 12 closed months</span></div>{{#if graph}}<svg viewBox="0 0 {{graph.W}} {{graph.H}}" class="cel-graph" role="img" aria-label="Profit history"><defs><linearGradient id="cel-chart-fill" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#58dfcc" stop-opacity=".22"/><stop offset="1" stop-color="#58dfcc" stop-opacity="0"/></linearGradient></defs><line x1="0" x2="{{graph.W}}" y1="35" y2="35" class="gridline"/><line x1="0" x2="{{graph.W}}" y1="75" y2="75" class="gridline"/><line x1="0" x2="{{graph.W}}" y1="115" y2="115" class="gridline"/><line x1="0" x2="{{graph.W}}" y1="{{graph.zero}}" y2="{{graph.zero}}" class="zero"/><polygon class="area" points="{{graph.line}} {{graph.W}},{{graph.zero}} 0,{{graph.zero}}"/><polyline points="{{graph.line}}" class="glow"/><polyline points="{{graph.line}}" class="ln"/>{{#each graph.pts}}<circle cx="{{x}}" cy="{{y}}" r="3"><title>{{m}}</title></circle><text x="{{x}}" y="148" class="tick">{{m}}</text>{{/each}}</svg>{{else}}<div class="empty-state"><i class="fa-solid fa-chart-line"></i><h4>Your story starts here</h4><p>Close two months to see the profit trend. No sample figures are shown.</p></div>{{/if}}<div class="chart-legend"><span><i class="legend-dot"></i>Realized profit</span><span>Ledger coins</span></div></article>
<article class="cel-panel health"><div class="panel-heading"><div><p class="eyebrow">PULSE</p><h3>Company health</h3></div><i class="fa-solid fa-heart-pulse"></i></div><label class="progress-label"><span>Crew morale</span><b>{{avg}}%</b></label><progress max="100" value="{{avg}}" aria-label="Crew morale"></progress><label class="progress-label"><span>Reputation · {{repTier}}</span><b>{{reputation}}%</b></label><progress class="violet" max="100" value="{{reputation}}" aria-label="Reputation"></progress><label class="progress-label"><span>Heat</span><b>{{heat}}%</b></label><progress class="amber" max="100" value="{{heat}}" aria-label="Heat"></progress><button type="button" data-action="celShowTab" data-tab="events" class="health-status {{#if threats}}warn{{/if}}"><i class="fa-solid fa-shield-halved"></i>{{threats}} active threats <span>→</span></button><div class="health-meta"><span>{{staff.length}} crew</span><span>{{branches.length}} branches</span><span>{{runningRoutes}} routes</span></div></article>
<article class="cel-panel"><div class="panel-heading"><h3>Active contracts</h3><button type="button" class="text-btn" data-action="celShowTab" data-tab="contracts">View all →</button></div>{{#each activeContracts}}<div class="summary-row"><div><b>{{title}}</b><small>{{client}} · {{months}} months left</small></div><span class="badge">{{progress}} / {{required}}</span><progress max="{{required}}" value="{{progress}}" aria-label="{{title}} progress"></progress></div>{{else}}<div class="empty-state compact"><i class="fa-regular fa-file-lines"></i><p>No active contracts</p></div>{{/each}}</article>
<article class="cel-panel"><div class="panel-heading"><h3>PC duty</h3><button type="button" class="text-btn" data-action="celShowTab" data-tab="duty">Week {{week}} →</button></div>{{#each pcs}}<div class="person-row"><img src="{{img}}" alt="" class="avatar"><div><b>{{name}}</b><small>{{roleLabel}}</small></div><span class="badge">{{taskLabel}}</span></div>{{else}}<div class="empty-state compact"><i class="fa-solid fa-user-group"></i><p>No characters assigned yet</p></div>{{/each}}</article></div>
<div class="cel-panel"><div class="panel-heading"><h3>Monthly ledger</h3><span class="muted">Closed-month results</span></div>{{#if history.length}}<div class="table-scroll"><table class="cel-table"><thead><tr><th>Month</th><th>Income</th><th>Costs</th><th>Profit</th></tr></thead><tbody>{{#each history}}<tr><td>{{month}}</td><td>{{income}}</td><td>{{costs}}</td><td class="{{#if (gte profit 0)}}pos{{else}}neg{{/if}}">{{profit}}</td></tr>{{/each}}</tbody></table></div>{{else}}<p class="muted">No months closed yet.</p>{{/if}}</div>
{{#if isGM}}<div class="overview-actions"><div><h3>Ready for the next chapter?</h3><p class="muted">Resolve operations and record this month's results.</p></div><button type="button" class="cel-big" data-action="celCloseMonth"><i class="fa-solid fa-arrow-right"></i> Close month {{state.month}}</button></div><details class="cel-panel tools"><summary>Workspace tools <span class="muted">v{{version}} · schema {{schema}}</span></summary><div class="cel-toolbar"><button type="button" data-action="celSelfTest">Self-test</button><button type="button" data-action="celExport">Backup</button><button type="button" data-action="celImport">Restore</button><button type="button" class="x" data-action="celReset">Reset ledger</button></div><p class="muted">Self-test uses disposable data, not your saved ledger.</p></details>{{/if}}{{/if}}
{{#if tabs.tasks}}<div class="cel-panel parch"><h3>YOUR TASK THIS MONTH</h3>{{#if canAct}}<div class="cel-form"><label>Task<select name="task">{{#each taskDefs}}<option value="{{key}}">{{label}}</option>{{/each}}</select></label><label>Target<select name="target"><option value="">— select if needed —</option><optgroup label="Threats">{{#each targetThreats}}<option value="{{id}}">{{label}}</option>{{/each}}</optgroup><optgroup label="Routes">{{#each targetRoutes}}<option value="{{id}}">{{label}}</option>{{/each}}</optgroup><optgroup label="Contracts">{{#each targetContracts}}<option value="{{id}}">{{label}}</option>{{/each}}</optgroup><optgroup label="Rivals">{{#each targetRivals}}<option value="{{id}}">{{label}}</option>{{/each}}</optgroup><optgroup label="Divisions">{{#each targetDivisions}}<option value="{{id}}">{{label}}</option>{{/each}}</optgroup><optgroup label="Branches">{{#each targetBranches}}<option value="{{id}}">{{label}}</option>{{/each}}</optgroup></select></label><label>Asset / skill steps<input name="steps" type="number" min="0" max="3" value="0"></label><button type="button" class="cel-big small" data-action="celDoTask">🎲 PERFORM TASK</button></div>{{else}}<p>You have already acted this month.</p>{{/if}}</div><div class="cel-grid wide">{{#each tasks}}<div class="cel-card ev"><h4>{{label}}</h4><p>{{who}} · {{userName}}</p><p>Roll {{total}} vs {{tn}} · {{#if success}}<b class="pos">SUCCESS</b>{{else}}<b class="neg">FAILED</b>{{/if}}</p><p>{{text}}</p>{{#if @root.isGM}}<button type="button" class="x" data-action="celRemove" data-list="tasks" data-id="{{id}}">UNDO / RETRY</button>{{/if}}</div>{{else}}<p>No tasks yet.</p>{{/each}}</div>{{/if}}
{{#if tabs.staff}}{{#if isGM}}<div class="cel-drop" data-kind="Actor" data-target="staff">⬇ Drag NPC here to hire</div>{{/if}}<div class="cel-grid">{{#each staff}}<div class="cel-card"><div class="ring" style="--pct:{{happiness}}"><img src="{{img}}"><span class="mood">{{mood}}</span></div><h4>{{name}}</h4><label>Role<input data-edit="staff" data-id="{{id}}" data-field="role" value="{{role}}" {{#unless @root.isGM}}disabled{{/unless}}></label><label>Specialty<select data-edit="staff" data-id="{{id}}" data-field="spec" {{#unless @root.isGM}}disabled{{/unless}}>{{selectOptions @root.specChoices selected=spec}}</select></label><label>Wage<input type="number" data-edit="staff" data-id="{{id}}" data-field="wage" value="{{wage}}" {{#unless @root.isGM}}disabled{{/unless}}></label><label>Morale<input type="number" data-edit="staff" data-id="{{id}}" data-field="happiness" value="{{happiness}}" {{#unless @root.isGM}}disabled{{/unless}}></label>{{#if @root.isGM}}<button type="button" class="x" data-action="celRemove" data-list="staff" data-id="{{id}}">DISMISS</button>{{/if}}</div>{{else}}<p>No crew.</p>{{/each}}</div>{{/if}}
{{#if tabs.duty}}{{#if isGM}}<div class="cel-drop" data-kind="Actor" data-target="pc">Drop a PC Actor here</div>{{/if}}<div class="cel-panel"><div class="panel-heading"><div><p class="eyebrow">PEOPLE &amp; PURPOSE</p><h3>Week {{week}} · Weekly duty</h3></div>{{#if isGM}}<button type="button" class="primary" data-action="celResolveWeek">Close week &amp; roll duties</button>{{/if}}</div><p class="muted">Roll d20 + role + sheet skill + tuning against TN. A natural 20 doubles supported effects; a natural 1 adds 2 heat.</p><div class="token-row"><span class="badge">Production {{momentum.production}} · +{{momIncome}} income</span><span class="badge">Trade {{momentum.trade}} · +{{momentum.trade}} per route</span><span class="muted">Tokens last until month close.</span></div></div><div class="cel-grid">{{#each pcs}}<article class="cel-card"><div class="card-person"><img class="avatar large" src="{{img}}" alt="{{name}}"><div><h4>{{name}}</h4><span class="badge">{{roleLabel}}</span></div></div><p>{{taskLabel}}{{#if taskTn}} · TN {{taskTn}}{{/if}}</p><p class="muted">{{taskDesc}}</p><p class="muted">{{#each domains}}{{this}}{{#unless @last}} · {{/unless}}{{/each}}</p>{{#if @root.isGM}}<label>Role<select data-edit="pcs" data-id="{{id}}" data-field="role">{{selectOptions @root.pcRoleChoices selected=role}}</select></label><label>Duty<select data-edit="pcs" data-id="{{id}}" data-field="task">{{selectOptions @root.pcTaskChoices selected=task}}</select></label><label>Tuning<input type="number" min="-2" max="2" data-edit="pcs" data-id="{{id}}" data-field="adj" value="{{adj}}"></label><button type="button" class="x" data-action="celRemove" data-list="pcs" data-id="{{id}}">Remove</button>{{/if}}</article>{{else}}<div class="empty-state"><h4>Your team belongs here</h4><p>Ask the GM to add character Actors to the duty board.</p></div>{{/each}}</div><details class="cel-panel"><summary>Duty reference</summary><div class="reference-grid">{{#each taskCatalog}}<div><b>{{label}} · TN {{tn}}</b><p class="muted">{{desc}}</p></div>{{/each}}</div></details>{{#if weekLog}}<div class="cel-panel"><h3>Weekly activity</h3>{{#each weekLog}}<div class="log-row"><span class="badge">W{{wk}}</span><div><b>{{name}} · {{task}}</b><p>d20 {{nat}} + {{bonus}} = {{total}} vs {{tn}} · {{outcome}}</p><p class="muted">{{detail}}</p></div></div>{{/each}}</div>{{/if}}{{/if}}
{{#if tabs.execs}}<div class="cel-panel parch"><h3>BOARDROOM · {{pp.left}} PERK POINTS</h3><p class="muted">Assign executives; tiers cost 1, 2, 3. Salary {{salary}} monthly each.</p></div><div class="seats">{{#each seats}}<div class="seat {{#if vacant}}vacant{{/if}} {{#if dormant}}dormant{{/if}}"><div class="plate">{{icon}} {{title}}</div><div class="sbody">{{#if exec}}<div class="ring" style="--pct:{{exec.happiness}}"><img src="{{exec.img}}"><span>{{exec.mood}}</span></div><b>{{exec.name}}</b>{{else}}🪑 Vacant{{/if}}<select data-edit="exec" data-field="{{key}}" {{#unless @root.isGM}}disabled{{/unless}}>{{selectOptions assignChoices selected=current}}</select></div><div class="rungs">{{#each tiers}}<div class="rung {{#if isOwned}}owned{{/if}} {{#if live}}live{{/if}} {{#if locked}}locked{{/if}}"><span class="tier">{{tier}}</span><div class="rtext"><b>{{name}}</b><small>{{desc}}</small></div>{{#if isOwned}}✔{{else}}{{#if buyable}}{{#if @root.isGM}}<button type="button" data-action="celBuyPerk" data-seat="{{../key}}" data-tier="{{tier}}">BUY {{cost}}</button>{{else}}{{cost}} pt{{/if}}{{else}}{{cost}} pt{{/if}}{{/if}}</div>{{/each}}</div>{{#if @root.isGM}}{{#if owned}}<button type="button" class="x" data-action="celRespec" data-seat="{{key}}">REFUND</button>{{/if}}{{/if}}</div>{{/each}}</div><div class="cel-panel parch"><h3>ACTIVE BONUSES</h3><ul class="bonuses">{{#each bonuses}}<li>{{this}}</li>{{/each}}</ul></div>{{/if}}
{{#if tabs.places}}{{#if isGM}}<div class="cel-drop" data-kind="Scene" data-target="place">Drop a Scene · multi-level scenes become buildings</div>{{/if}}<div class="cel-grid">{{#each places}}<article class="cel-card place {{#if hasFloors}}building{{/if}}"><div class="card-person"><div class="thumb" style="background-image:url('{{img}}')"></div><div><h4>{{name}}</h4><small>{{totals.active}} / {{totals.floorCount}} floors · upkeep {{totals.upkeep}} · bonus {{totals.bonus}}</small></div></div>{{#if hasFloors}}<div class="floor-list">{{#each floors}}<div class="floor">{{#if @root.isGM}}<label>Name<input type="text" data-edit="floor" data-id="{{id}}" data-field="name" data-place="{{../id}}" value="{{name}}" ></label><label>Type<select data-edit="floor" data-id="{{id}}" data-field="type" data-place="{{../id}}">{{selectOptions @root.floorTypes selected=type}}</select></label><label>Upkeep<input type="number" data-edit="floor" data-id="{{id}}" data-field="upkeep" data-place="{{../id}}" value="{{upkeep}}" ></label><label>Bonus<input type="number" data-edit="floor" data-id="{{id}}" data-field="bonus" data-place="{{../id}}" value="{{bonus}}" ></label><label class="check-label">Active<input type="checkbox" data-edit="floor" data-id="{{id}}" data-field="active" data-place="{{../id}}" {{checked active}}></label><button type="button" data-action="celVisitFloor" data-uuid="{{../uuid}}" data-level="{{levelId}}">Visit</button><button type="button" class="x" data-action="celRemoveFloor" data-place="{{../id}}" data-id="{{id}}">Remove floor</button>{{else}}<b>{{name}}</b><span>{{type}}</span><span>Upkeep {{upkeep}}</span><span>Bonus {{bonus}}</span><span>{{#if active}}Active{{else}}Inactive{{/if}}</span>{{/if}}</div>{{/each}}</div>{{else}}{{#if @root.isGM}}<div class="rgrid"><label>Upkeep<input type="number" data-edit="places" data-id="{{id}}" data-field="upkeep"  value="{{upkeep}}" ></label><label>Bonus<input type="number" data-edit="places" data-id="{{id}}" data-field="bonus"  value="{{bonus}}" ></label></div>{{else}}<p>Upkeep {{upkeep}} · Bonus {{bonus}}</p>{{/if}}{{/if}}{{#if @root.isGM}}<div class="cel-toolbar"><button type="button" data-action="celOpenScene" data-uuid="{{uuid}}">Visit scene</button><button type="button" data-action="celAddFloor" data-id="{{id}}">Add floor</button><button type="button" data-action="celSyncFloors" data-id="{{id}}">Sync floors</button><button type="button" class="x" data-action="celRemove" data-list="places" data-id="{{id}}">Remove workshop</button></div>{{/if}}</article>{{else}}<div class="empty-state"><h4>Room to grow</h4><p>No workshops linked yet.</p></div>{{/each}}</div>{{/if}}
{{#if tabs.routes}}<div class="cel-panel"><div class="panel-heading"><h3>Market board</h3><span class="muted">{{runningRoutes}} running · {{routeCap}} slots · cargo cap {{cargoCap}}</span></div><div class="market">{{#each market}}<div class="chip {{cls}}"><small>{{label}}</small><b>{{arrow}} {{pct}}%</b></div>{{/each}}</div></div>{{#if isGM}}<div class="cel-drop" data-kind="Scene" data-target="route">Drop a destination Scene to add a trade route</div><div class="cel-toolbar"><button type="button" data-action="celAddRoute">Add route</button></div>{{/if}}<div class="cel-routes">{{#each routes}}<article class="route {{stateCls}}"><div class="rtop"><h4>{{name}}</h4><span class="badge">{{status}}</span></div><div class="lane"><span>{{from}}</span><div class="rail"><span class="cart">→</span></div><span>{{to}}</span></div><div class="rstats"><span>{{good}}</span><span>{{mode}}</span><span>TN {{tn}}</span><span>{{oddsPct}}% odds</span><span>Expected net {{expectedNet}}</span></div>{{#if @root.isGM}}<div class="rgrid c4"><label>Name<input type="text" data-edit="routes" data-id="{{id}}" data-field="name"  value="{{name}}" ></label><label>From<input type="text" data-edit="routes" data-id="{{id}}" data-field="from"  value="{{from}}" ></label><label>To<input type="text" data-edit="routes" data-id="{{id}}" data-field="to"  value="{{to}}" ></label><label>Good<select data-edit="routes" data-id="{{id}}" data-field="good" >{{selectOptions @root.goodChoices selected=good}}</select></label><label>Mode<select data-edit="routes" data-id="{{id}}" data-field="mode" >{{selectOptions @root.modeChoices selected=mode}}</select></label><label>Legs<input type="number" data-edit="routes" data-id="{{id}}" data-field="legs"  value="{{legs}}" ></label><label>Cargo<input type="number" data-edit="routes" data-id="{{id}}" data-field="cargo"  value="{{cargo}}" ></label><label>Risk modifier<input type="number" data-edit="routes" data-id="{{id}}" data-field="riskMod"  value="{{riskMod}}" ></label><label>Route master<select data-edit="routes" data-id="{{id}}" data-field="master" >{{selectOptions @root.crewChoices selected=master}}</select></label></div><div class="rtop"><label class="check-label">Running<input type="checkbox" data-edit="routes" data-id="{{id}}" data-field="active"  {{checked active}}></label><button type="button" class="x" data-action="celRemove" data-list="routes" data-id="{{id}}">Close route</button></div>{{/if}}</article>{{else}}<div class="empty-state"><h4>New horizons await</h4><p>No trade routes yet.</p></div>{{/each}}</div>{{/if}}
{{#if tabs.contracts}}<div class="cel-panel"><div class="panel-heading"><h3>{{repTier}} · Reputation {{reputation}} / 100</h3><span class="badge">{{activeCount}} / {{contractCap}} active</span></div><progress class="violet" max="100" value="{{reputation}}" aria-label="Reputation"></progress></div>{{#if isGM}}<div class="cel-drop" data-kind="Actor" data-target="contract">Drop an NPC Actor to create a client contract</div><div class="cel-toolbar"><button type="button" data-action="celRollOffer">New offer</button><button type="button" data-action="celCustomContract">Custom contract</button></div>{{/if}}<div class="cel-routes">{{#each contracts}}<article class="contract active {{#if done}}ready{{/if}}"><div class="rtop"><h4>{{title}}</h4><span class="badge">{{#if isActive}}Active{{else}}Offered{{/if}}</span></div><p>{{client}} · {{typeLabel}}</p><div class="cprog"><span>{{progress}} / {{required}} progress · {{months}} months</span><span>Reward {{reward}} · TN {{tn}} · penalty {{penalty}}</span></div><progress value="{{progress}}" max="{{required}}" aria-label="{{title}} progress"></progress><div class="pips">{{#each pips}}<span class="pip {{#if on}}on{{/if}}"></span>{{/each}}</div>{{#if isActive}}<div class="ccrew">{{#each crewList}}<span class="cchip">{{#if img}}<img src="{{img}}" alt="">{{/if}}{{name}} +{{bonus}}{{#if spec}} ★{{/if}}{{#if @root.isGM}}<button type="button" class="x" data-action="celUnassign" data-id="{{../id}}" data-crew="{{id}}" aria-label="Unassign {{name}}">×</button>{{/if}}</span>{{/each}}{{#if canAssign}}{{#if @root.isGM}}<select aria-label="Assign crew" data-edit="assign" data-id="{{id}}">{{selectOptions assignChoices}}</select>{{/if}}{{/if}}</div>{{/if}}{{#if isOffered}}{{#if @root.isGM}}<button type="button" class="primary" data-action="celAcceptContract" data-id="{{id}}">Accept contract</button>{{/if}}{{/if}}{{#if @root.isGM}}<div class="rgrid c4"><label>Title<input type="text" data-edit="contracts" data-id="{{id}}" data-field="title"  value="{{title}}" ></label><label>Progress<input type="number" data-edit="contracts" data-id="{{id}}" data-field="progress"  value="{{progress}}" ></label><label>Required<input type="number" data-edit="contracts" data-id="{{id}}" data-field="required"  value="{{required}}" ></label><label>Months<input type="number" data-edit="contracts" data-id="{{id}}" data-field="months"  value="{{months}}" ></label><label>Reward<input type="number" data-edit="contracts" data-id="{{id}}" data-field="reward"  value="{{reward}}" ></label></div><button type="button" class="x" data-action="celRemove" data-list="contracts" data-id="{{id}}">Remove</button>{{/if}}</article>{{else}}<div class="empty-state"><h4>Find your next opportunity</h4><p>No contract offers yet.</p></div>{{/each}}</div>{{#if contractLog}}<details class="cel-panel"><summary>Contract history</summary>{{#each contractLog}}<p>Month {{month}} · {{title}} · {{outcome}} · {{amount}}</p>{{/each}}</details>{{/if}}{{/if}}
{{#if tabs.branches}}<div class="cel-panel parch"><h3>BRANCH OFFICES · PLAYER-RUN SUBSIDIARIES</h3><p class="muted">Income: {{rates.tier}} per tier + {{rates.staff}} per staff. Costs: {{rates.wage}} per staff + {{rates.upkeep}} per tier. Max tier at rank {{state.level}}: {{tierCap}}. Dividends convert at {{dividendRate}} ledger coins to 1 gold; 100 coin reserve.</p><ul class="bonuses">{{#each synergies}}<li>{{this}}</li>{{/each}}</ul></div>{{#if isGM}}<div class="cel-toolbar"><button type="button" data-action="celAddBranch">＋ OPEN BRANCH</button><label class="rrun">Default tithe % <input type="number" min="0" max="60" data-edit="business" data-field="branchTithe" value="{{state.branchTithe}}"></label><label class="rrun">Coins / gold <input type="number" min="1" max="100" data-edit="business" data-field="dividendRate" value="{{dividendRate}}"></label></div>{{/if}}<div class="cel-note">HQ branch tithe projection: <b class="pos">+{{f.branchInc}}</b></div><div class="cel-routes">{{#each branches}}<div class="branch {{#if mine}}mine{{/if}}"><div class="chead"><div class="cportrait">🏢</div><div class="ctitle"><b class="rname">{{name}}</b><small>{{ownerName}} · {{focusIcon}} {{focusLabel}} {{#if mine}}· YOUR BRANCH{{/if}}</small></div><span class="rstate">TIER {{tier}} / {{tierCap}}</span></div><div class="rstats"><span>Treasury <b>{{cash}}</b></span><span>Staff {{staff}}/{{hireCap}}</span><span>Morale {{morale}}%</span><span>Income {{gross}}</span><span>Costs {{costs}}</span><span>Profit {{profit}}</span><span>HQ tithe {{tithe}} ({{tithe_pct}}%)</span><span>Kept {{keep}}</span><span>Growth {{growth}}/{{need}}</span></div><p class="muted">{{focusSyn}}</p>{{#if canAct}}<div class="ccrew">{{#each stances}}<button type="button" class="stancebtn {{#if on}}on{{/if}}" data-action="celBranchStance" data-id="{{../id}}" data-stance="{{key}}">{{icon}} {{label}}</button>{{/each}}<button type="button" data-action="celBranchHire" data-id="{{id}}" {{#unless canHire}}disabled{{/unless}}>HIRE ({{@root.hireCost}})</button><button type="button" data-action="celBranchUpgrade" data-id="{{id}}" {{#unless canUpgrade}}disabled{{/unless}}>UPGRADE ({{upCost}})</button><button type="button" data-action="celBranchDividend" data-id="{{id}}" {{#unless goldMax}}disabled{{/unless}}>DIVIDEND ({{goldMax}} gold)</button></div>{{/if}}{{#if @root.isGM}}<div class="rgrid c4"><label>Focus<select data-edit="branches" data-id="{{id}}" data-field="focus">{{selectOptions @root.branchFocusChoices selected=focus}}</select></label><label>Tier<input type="number" data-edit="branches" data-id="{{id}}" data-field="tier" value="{{tier}}"></label><label>Staff<input type="number" data-edit="branches" data-id="{{id}}" data-field="staff" value="{{staff}}"></label><label>Cash<input type="number" data-edit="branches" data-id="{{id}}" data-field="cash" value="{{cash}}"></label><label>Tithe<input type="number" data-edit="branches" data-id="{{id}}" data-field="tithe" value="{{tithe_pct}}"></label><label>Morale<input type="number" data-edit="branches" data-id="{{id}}" data-field="morale" value="{{morale}}"></label></div><div class="cel-drop sm" data-kind="Scene" data-target="branch" data-id="{{id}}">⬇ Drop a Scene for this branch</div><button type="button" class="x" data-action="celRemove" data-list="branches" data-id="{{id}}">CLOSE BRANCH</button>{{/if}}</div>{{else}}<p>No branches yet.</p>{{/each}}</div>{{/if}}
{{#if tabs.spies}}<div class="cel-panel"><div class="panel-heading"><h3>Counter-intelligence</h3><span class="badge">Defence {{def.total}} · Heat {{heat}}</span></div><progress class="amber" value="{{heat}}" max="100" aria-label="Heat"></progress><h4>Security · {{guardList.length}} / 3 guards</h4><div class="ccrew">{{#each guardList}}<span class="cchip">{{name}} +{{bonus}}{{#if @root.isGM}}<button type="button" class="x" data-action="celUnguard" data-crew="{{id}}" aria-label="Remove guard {{name}}">×</button>{{/if}}</span>{{/each}}{{#if isGM}}{{#if canGuard}}<select aria-label="Assign guard" data-edit="guard">{{selectOptions guardChoices}}</select>{{/if}}{{/if}}</div><p class="muted">Each guard adds {{guardValue}} defence. Stealth/combat specialists add +1. Running spy operations cost upkeep and raise heat.</p></div>{{#if isGM}}<div class="cel-drop" data-kind="Actor" data-target="rival">Drop an NPC Actor to link a rival leader</div><div class="cel-toolbar"><button type="button" data-action="celAddRival">Add rival</button></div>{{/if}}<div class="cel-routes">{{#each rivals}}<article class="rival"><div class="rtop"><h4>{{name}}</h4><span class="badge">{{#if known}}Plan known{{else}}Intel {{intel}} / {{@root.intelPlan}}{{/if}}</span></div><div class="rstats"><span>Strength {{strength}}</span><span>Secrecy {{secrecy}}</span><span>Aggression {{aggression}}</span><span>Income drag −{{drag}}</span>{{#if stunned}}<span>Stunned {{stunned}} months</span>{{/if}}</div><div class="rplan {{#if planHot}}warn{{/if}}">{{planText}}</div>{{#if @root.isGM}}<div class="rgrid c4"><label>Strength<input type="number" data-edit="rivals" data-id="{{id}}" data-field="strength"  value="{{strength}}" ></label><label>Secrecy<input type="number" data-edit="rivals" data-id="{{id}}" data-field="secrecy"  value="{{secrecy}}" ></label><label>Aggression<input type="number" data-edit="rivals" data-id="{{id}}" data-field="aggression"  value="{{aggression}}" ></label><label>Intel<input type="number" data-edit="rivals" data-id="{{id}}" data-field="intel"  value="{{intel}}" ></label></div><div class="cel-toolbar"><button type="button" data-action="celAddOp" data-rival="{{id}}">Add operation</button><button type="button" class="x" data-action="celRemove" data-list="rivals" data-id="{{id}}">Remove rival</button></div>{{/if}}<div class="ops">{{#each ops}}<div class="op {{#unless running}}idle{{/unless}}"><div class="rtop">{{#if @root.isGM}}<select aria-label="Operation type" data-edit="ops" data-id="{{id}}" data-field="kind">{{selectOptions @root.opKindChoices selected=kind}}</select>{{else}}<b>{{kind}}</b>{{/if}}<span class="badge">TN {{tn}} · {{oddsPct}}% · {{cost}}/mo</span></div><div class="ccrew">{{#each crewList}}<span class="cchip">{{name}}{{#if @root.isGM}}<button type="button" class="x" data-action="celOpUnassign" data-id="{{../id}}" data-crew="{{id}}" aria-label="Unassign {{name}}">×</button>{{/if}}</span>{{/each}}{{#if canAssign}}{{#if @root.isGM}}<select aria-label="Assign agent" data-edit="opcrew" data-id="{{id}}">{{selectOptions assignChoices}}</select>{{/if}}{{/if}}</div><p class="muted">{{desc}}{{#if wary}} · Wary: increased TN{{/if}}{{#if noCrew}} · No crew assigned{{/if}}</p><div class="rtop"><label class="check-label"><input type="checkbox" data-edit="ops" data-id="{{id}}" data-field="active" {{checked active}} {{#unless @root.isGM}}disabled{{/unless}}>Active</label>{{#if @root.isGM}}<button type="button" class="x" data-action="celRemove" data-list="ops" data-id="{{id}}">Remove operation</button>{{/if}}</div></div>{{/each}}</div></article>{{else}}<div class="empty-state"><h4>A quiet horizon</h4><p>No rival companies recorded.</p></div>{{/each}}</div>{{#if spyLog}}<details class="cel-panel"><summary>Intelligence log</summary>{{#each spyLog}}<p>Month {{month}} · {{text}}</p>{{/each}}</details>{{/if}}{{/if}}
{{#if tabs.deals}}<div class="cel-panel"><div class="panel-heading"><h3>Divisions</h3><span class="badge">Net {{f.divNet}}</span></div>{{#each divisions}}<div class="division"><div class="rtop"><h4>{{name}}</h4><span class="badge">{{integration}}% integrated</span></div><progress class="violet" value="{{integration}}" max="100" aria-label="{{name}} integration"></progress><div class="rstats"><span>Income {{income}}</span><span>Upkeep {{upkeep}}</span><span>Net {{net}}</span><span>{{kindLabel}}</span></div>{{#if @root.isGM}}<label>Division head<select data-edit="divhead" data-id="{{id}}">{{selectOptions headChoices selected=headId}}</select></label><button type="button" class="x" data-action="celDivest" data-id="{{id}}">Sell division · {{divestValue}}</button>{{/if}}</div>{{else}}<p class="muted">No divisions acquired yet.</p>{{/each}}</div><div class="cel-routes">{{#each deals}}<article class="deal"><div class="rtop"><h4>{{name}}</h4><span class="badge">Strength {{strength}} · Intel {{intel}}</span></div>{{#if courted}}<p class="muted">Courted · {{courted}} months remaining</p>{{/if}}{{#if @root.isGM}}<label>Offer premium<select data-edit="rivals" data-id="{{id}}" data-field="premium">{{selectOptions @root.premiumChoices selected=premium}}</select></label>{{/if}}<div class="dealopts"><div class="dealbox"><h4>Takeover</h4><b class="deal-price">{{buyout.price}}</b><p>{{buyout.oddsPct}}% odds · TN {{buyout.tn}}</p>{{#if buyout.blocked}}<p class="warn">{{buyout.blocked}}</p>{{/if}}{{#if @root.isGM}}<button type="button" data-action="celDeal" data-rival="{{id}}" data-kind="buyout" {{#if buyout.blocked}}disabled{{/if}}>Make offer</button>{{/if}}</div><div class="dealbox"><h4>Merger</h4><b class="deal-price">{{merger.price}}</b><p>{{merger.oddsPct}}% odds · TN {{merger.tn}}</p>{{#if merger.blocked}}<p class="warn">{{merger.blocked}}</p>{{/if}}{{#if @root.isGM}}<button type="button" data-action="celDeal" data-rival="{{id}}" data-kind="merger" {{#if merger.blocked}}disabled{{/if}}>Propose merger</button>{{/if}}</div></div></article>{{else}}<div class="empty-state"><h4>Build your network</h4><p>No acquisition targets.</p></div>{{/each}}</div>{{#if dealLog}}<details class="cel-panel"><summary>Deal history</summary>{{#each dealLog}}<p>Month {{month}} · {{text}}</p>{{/each}}</details>{{/if}}{{/if}}
{{#if tabs.events}}{{#if isGM}}<div class="cel-toolbar"><button type="button" data-action="celRollEvent" data-kind="internal">INTERNAL</button><button type="button" data-action="celRollEvent" data-kind="external">EXTERNAL</button><button type="button" data-action="celRollEvent" data-kind="any">ANY</button><button type="button" data-action="celCustomEvent">CUSTOM</button></div>{{/if}}<div class="cel-grid wide">{{#each events}}<div class="cel-card ev {{kind}} {{#if threat}}threat{{else}}boon{{/if}}"><h4>{{title}}</h4><p>{{desc}}</p><p>Income {{impact}} · Morale {{mor}} · {{duration}}</p>{{#if @root.isGM}}{{#if threat}}<button type="button" data-action="celResolveEvent" data-id="{{id}}">RESOLVE</button>{{/if}}<button type="button" class="x" data-action="celRemove" data-list="events" data-id="{{id}}">DISMISS</button>{{/if}}</div>{{else}}<p>All quiet.</p>{{/each}}</div>{{/if}}
{{#if tabs.trophies}}<div class="cel-panel parch"><h3>TROPHIES {{trophyCount}}/{{trophyTotal}}</h3><div class="cel-trophies">{{#each trophies}}<div class="trophy {{#if got}}got{{else}}locked{{/if}}"><div class="medal">{{#if got}}{{icon}}{{else}}🔒{{/if}}</div><h4>{{title}}</h4><p>{{desc}}</p></div>{{/each}}</div></div>{{/if}}

</section><footer class="workspace-foot"><span>Enterprise Ledger</span><span>Cypher System · {{#if isGM}}GM{{else}}Player{{/if}} · v{{version}}</span></footer></div></div>
