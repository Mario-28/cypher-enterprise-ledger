<div class="cel-root"><svg class="cel-sprite" width="0" height="0" aria-hidden="true"><defs><symbol id="i-book" viewBox="0 0 24 24"><path d="M5 4h11a3 3 0 0 1 3 3v13H8a3 3 0 0 1-3-3V4zM8 4v13M11 8h5"/></symbol><symbol id="i-task" viewBox="0 0 24 24"><path d="M4 6h2l1 1 2-2M11 6h9M4 12h2l1 1 2-2M11 12h9M4 18h2l1 1 2-2M11 18h9"/></symbol><symbol id="i-crew" viewBox="0 0 24 24"><path d="M9 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM3 20c0-3.3 2.7-6 6-6s6 2.7 6 6M17 10a2.5 2.5 0 1 0 0-5M16 14c3 0 5 2 5 5"/></symbol><symbol id="i-crown" viewBox="0 0 24 24"><path d="M4 18h16L19 8l-5 4-2-7-3 7-5-4-1 10z"/></symbol><symbol id="i-gear" viewBox="0 0 24 24"><path d="M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6zM12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M18.4 5.6l-2.1 2.1M7.7 16.3l-2.1-2.1"/></symbol><symbol id="i-train" viewBox="0 0 24 24"><path d="M6 4h12a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zM4 11h16M8 20l2-3M16 20l-2-3M8 14h.01M16 14h.01"/></symbol><symbol id="i-scroll" viewBox="0 0 24 24"><path d="M7 4h11v13a3 3 0 0 1-3 3H6a3 3 0 0 0 3-3V6a2 2 0 0 0-2-2zM10 9h5M10 13h5"/></symbol><symbol id="i-home" viewBox="0 0 24 24"><path d="M4 20V8l8-4 8 4v12M4 20h16M9 20v-5h6v5M9 11h.01M15 11h.01"/></symbol><symbol id="i-eye" viewBox="0 0 24 24"><path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12zM12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6z"/></symbol><symbol id="i-scale" viewBox="0 0 24 24"><path d="M12 4v16M5 7h14M5 7l-3 7a3 3 0 0 0 6 0L5 7zM19 7l-3 7a3 3 0 0 0 6 0l-3-7z"/></symbol><symbol id="i-bolt" viewBox="0 0 24 24"><path d="M13 3L5 14h6l-1 7 8-11h-6l1-7z"/></symbol><symbol id="i-cup" viewBox="0 0 24 24"><path d="M7 4h10v5a5 5 0 0 1-10 0V4zM7 6H4v2a3 3 0 0 0 3 3M17 6h3v2a3 3 0 0 1-3 3M12 14v4M8 20h8"/></symbol></defs></svg>
<header class="cel-header {#if banner}has-banner{/if}" {#if banner}style="--banner:url('{{banner}}')"{/if}>
<div class="nameplate"><span class="crystal"></span><div class="cel-logo">{{#if isGM}}<input class="cel-title-in" data-edit="business" data-field="name" value="{{state.name}}">{{else}}<span>{{state.name}}</span>{{/if}}</div><span class="gear-deco">⚙</span></div>
<div class="cel-badges"><span class="coin rank"><small>RANK</small>{{#if isGM}}<input type="number" min="1" max="10" data-edit="business" data-field="level" value="{{state.level}}">{{else}}<b>{{state.level}}</b>{{/if}}</span><span class="coin rep"><small>{{repTier}}</small><b>{{reputation}}</b></span><span class="coin perk"><small>PERKS</small><b>{{pp.left}}</b></span><span class="coin heat {{heatCls}}"><small>HEAT</small><b>{{heat}}</b></span><span class="coin month"><small>MONTH</small><b>{{state.month}}</b></span><span class="coin cash"><small>TREASURY</small>{{#if isGM}}<input type="number" data-edit="business" data-field="cash" value="{{state.cash}}">{{else}}<b>{{state.cash}}</b>{{/if}}</span></div></header>
<nav class="cel-tabs"><button type="button" data-action="celShowTab" data-tab="overview" class="{{#if tabs.overview}}active{{/if}} "><svg class="ico"><use href="#i-book"/></svg><span>COUNTING HOUSE</span></button>
<button type="button" data-action="celShowTab" data-tab="tasks" class="{{#if tabs.tasks}}active{{/if}} {{#if canAct}}todo{{/if}}"><svg class="ico"><use href="#i-task"/></svg><span>TASKS {{tasks.length}}</span></button>
<button type="button" data-action="celShowTab" data-tab="staff" class="{{#if tabs.staff}}active{{/if}} "><svg class="ico"><use href="#i-crew"/></svg><span>CREW {{staff.length}}</span></button>
<button type="button" data-action="celShowTab" data-tab="execs" class="{{#if tabs.execs}}active{{/if}} "><svg class="ico"><use href="#i-crown"/></svg><span>BOARDROOM</span></button>
<button type="button" data-action="celShowTab" data-tab="places" class="{{#if tabs.places}}active{{/if}} "><svg class="ico"><use href="#i-gear"/></svg><span>WORKSHOPS {{places.length}}</span></button>
<button type="button" data-action="celShowTab" data-tab="routes" class="{{#if tabs.routes}}active{{/if}} "><svg class="ico"><use href="#i-train"/></svg><span>TRADE {{routes.length}}</span></button>
<button type="button" data-action="celShowTab" data-tab="contracts" class="{{#if tabs.contracts}}active{{/if}} "><svg class="ico"><use href="#i-scroll"/></svg><span>CONTRACTS {{activeCount}}</span></button>
<button type="button" data-action="celShowTab" data-tab="branches" class="{{#if tabs.branches}}active{{/if}} "><svg class="ico"><use href="#i-home"/></svg><span>BRANCHES {{branches.length}}</span></button>
<button type="button" data-action="celShowTab" data-tab="spies" class="{{#if tabs.spies}}active{{/if}} "><svg class="ico"><use href="#i-eye"/></svg><span>INTRIGUE {{rivals.length}}</span></button>
<button type="button" data-action="celShowTab" data-tab="deals" class="{{#if tabs.deals}}active{{/if}} "><svg class="ico"><use href="#i-scale"/></svg><span>DEALS {{divisions.length}}</span></button>
<button type="button" data-action="celShowTab" data-tab="events" class="{{#if tabs.events}}active{{/if}} {{#if threats}}alert{{/if}}"><svg class="ico"><use href="#i-bolt"/></svg><span>EVENTS {{events.length}}</span></button>
<button type="button" data-action="celShowTab" data-tab="trophies" class="{{#if tabs.trophies}}active{{/if}} "><svg class="ico"><use href="#i-cup"/></svg><span>TROPHIES {{trophyCount}}/{{trophyTotal}}</span></button></nav>
<section class="cel-body">
{{#if tabs.overview}}
{{#if threats}}<div class="cel-alert">⚠ {{threats}} active threats · impact <b>{{f.evInc}}</b></div>{{/if}}
<div class="gauges">{{#each gauges}}<div class="gauge-card {{cls}}"><svg viewBox="0 0 100 64" class="dial"><path class="track" d="M10 54 A40 40 0 0 1 90 54"/><path class="arc" d="M10 54 A40 40 0 0 1 90 54" style="stroke-dasharray:{{arc}} 200"/><g class="ticks"><line x1="50" y1="15" x2="50" y2="21" transform="rotate(-90 50 54)"/><line x1="50" y1="15" x2="50" y2="21" transform="rotate(-60 50 54)"/><line x1="50" y1="15" x2="50" y2="21" transform="rotate(-30 50 54)"/><line x1="50" y1="15" x2="50" y2="21"/><line x1="50" y1="15" x2="50" y2="21" transform="rotate(30 50 54)"/><line x1="50" y1="15" x2="50" y2="21" transform="rotate(60 50 54)"/><line x1="50" y1="15" x2="50" y2="21" transform="rotate(90 50 54)"/></g><g class="needle" style="--ang:{{angle}}deg"><line x1="50" y1="54" x2="50" y2="22"/><circle cx="50" cy="54" r="4.5"/></g></svg><label>{{label}}</label><b data-count="{{value}}">{{value}}</b><small>{{sub}}</small></div>{{/each}}</div>
<div class="notes">{{#if routes.length}}<div class="cel-note">🚂 {{runningRoutes}} routes · expected route net <b>{{f.routeNet}}</b></div>{{/if}}{{#if activeCount}}<div class="cel-note">📜 {{activeCount}} active contracts.</div>{{/if}}{{#if branches.length}}<div class="cel-note">🏢 Branch tithes to HQ: <b class="pos">+{{f.branchInc}}</b></div>{{/if}}</div>
<div class="cel-panel parch"><h3>PROFIT TREND</h3>{{#if graph}}<svg viewBox="0 0 {{graph.W}} {{graph.H}}" class="cel-graph"><line x1="0" x2="{{graph.W}}" y1="{{graph.zero}}" y2="{{graph.zero}}" class="zero"/><polyline points="{{graph.line}}" class="glow"/><polyline points="{{graph.line}}" class="ln"/>{{#each graph.pts}}<circle cx="{{x}}" cy="{{y}}" r="4"/>{{/each}}</svg>{{else}}<p class="muted">Close two months to see the trend.</p>{{/if}}</div>
<div class="cel-panel parch"><h3>LEDGER</h3>{{#if history.length}}<table class="cel-table"><thead><tr><th>Month</th><th>Income</th><th>Costs</th><th>Profit</th></tr></thead><tbody>{{#each history}}<tr><td>{{month}}</td><td>{{income}}</td><td>{{costs}}</td><td class="{{#if (gte profit 0)}}pos{{else}}neg{{/if}}">{{profit}}</td></tr>{{/each}}</tbody></table>{{else}}<p class="muted">No months closed yet.</p>{{/if}}</div>
{{#if isGM}}<button type="button" class="cel-big" data-action="celCloseMonth"><span class="seal">⚙</span><span>CLOSE THE MONTH</span></button><div class="cel-panel tools"><h3>TOOLS · V{{version}} · SCHEMA {{schema}}</h3><div class="cel-toolbar"><button data-action="celSelfTest">🩺 SELF-TEST</button><button data-action="celExport">💾 BACKUP</button><button data-action="celImport">📥 RESTORE</button><button class="x" data-action="celReset">⚠ RESET</button></div><p class="muted">Self-test uses dummy data; it never changes this ledger. Header banner image is set in module settings.</p></div>{{/if}}
{{/if}}
{{#if tabs.tasks}}<div class="cel-panel parch"><h3>YOUR TASK THIS MONTH</h3>{{#if canAct}}<div class="cel-form"><label>Task<select name="task">{{#each taskDefs}}<option value="{{key}}">{{label}}</option>{{/each}}</select></label><label>Target<select name="target"><option value="">— select if needed —</option><optgroup label="Threats">{{#each targetThreats}}<option value="{{id}}">{{label}}</option>{{/each}}</optgroup><optgroup label="Routes">{{#each targetRoutes}}<option value="{{id}}">{{label}}</option>{{/each}}</optgroup><optgroup label="Contracts">{{#each targetContracts}}<option value="{{id}}">{{label}}</option>{{/each}}</optgroup><optgroup label="Rivals">{{#each targetRivals}}<option value="{{id}}">{{label}}</option>{{/each}}</optgroup><optgroup label="Divisions">{{#each targetDivisions}}<option value="{{id}}">{{label}}</option>{{/each}}</optgroup><optgroup label="Branches">{{#each targetBranches}}<option value="{{id}}">{{label}}</option>{{/each}}</optgroup></select></label><label>Asset / skill steps<input name="steps" type="number" min="0" max="3" value="0"></label><button class="cel-big small" data-action="celDoTask">🎲 PERFORM TASK</button></div>{{else}}<p>You have already acted this month.</p>{{/if}}</div><div class="cel-grid wide">{{#each tasks}}<div class="cel-card ev"><h4>{{label}}</h4><p>{{who}} · {{userName}}</p><p>Roll {{total}} vs {{tn}} · {{#if success}}<b class="pos">SUCCESS</b>{{else}}<b class="neg">FAILED</b>{{/if}}</p><p>{{text}}</p>{{#if @root.isGM}}<button class="x" data-action="celRemove" data-list="tasks" data-id="{{id}}">UNDO / RETRY</button>{{/if}}</div>{{else}}<p>No tasks yet.</p>{{/each}}</div>{{/if}}
{{#if tabs.staff}}{{#if isGM}}<div class="cel-drop" data-kind="Actor" data-target="staff">⬇ Drag NPC here to hire</div>{{/if}}<div class="cel-grid">{{#each staff}}<div class="cel-card"><div class="ring" style="--pct:{{happiness}}"><img src="{{img}}"><span class="mood">{{mood}}</span></div><h4>{{name}}</h4><label>Role<input data-edit="staff" data-id="{{id}}" data-field="role" value="{{role}}" {{#unless @root.isGM}}disabled{{/unless}}></label><label>Specialty<select data-edit="staff" data-id="{{id}}" data-field="spec" {{#unless @root.isGM}}disabled{{/unless}}>{{selectOptions @root.specChoices selected=spec}}</select></label><label>Wage<input type="number" data-edit="staff" data-id="{{id}}" data-field="wage" value="{{wage}}" {{#unless @root.isGM}}disabled{{/unless}}></label><label>Morale<input type="number" data-edit="staff" data-id="{{id}}" data-field="happiness" value="{{happiness}}" {{#unless @root.isGM}}disabled{{/unless}}></label>{{#if @root.isGM}}<button class="x" data-action="celRemove" data-list="staff" data-id="{{id}}">DISMISS</button>{{/if}}</div>{{else}}<p>No crew.</p>{{/each}}</div>{{/if}}
{{#if tabs.execs}}<div class="cel-panel parch"><h3>BOARDROOM · {{pp.left}} PERK POINTS</h3><p class="muted">Assign executives; tiers cost 1, 2, 3. Salary {{salary}} monthly each.</p></div><div class="seats">{{#each seats}}<div class="seat {{#if vacant}}vacant{{/if}} {{#if dormant}}dormant{{/if}}"><div class="plate">{{icon}} {{title}}</div><div class="sbody">{{#if exec}}<div class="ring" style="--pct:{{exec.happiness}}"><img src="{{exec.img}}"><span>{{exec.mood}}</span></div><b>{{exec.name}}</b>{{else}}🪑 Vacant{{/if}}<select data-edit="exec" data-field="{{key}}" {{#unless @root.isGM}}disabled{{/unless}}>{{selectOptions assignChoices selected=current}}</select></div><div class="rungs">{{#each tiers}}<div class="rung {{#if isOwned}}owned{{/if}} {{#if live}}live{{/if}} {{#if locked}}locked{{/if}}"><span class="tier">{{tier}}</span><div class="rtext"><b>{{name}}</b><small>{{desc}}</small></div>{{#if isOwned}}✔{{else}}{{#if buyable}}{{#if @root.isGM}}<button data-action="celBuyPerk" data-seat="{{../key}}" data-tier="{{tier}}">BUY {{cost}}</button>{{else}}{{cost}} pt{{/if}}{{else}}{{cost}} pt{{/if}}{{/if}}</div>{{/each}}</div>{{#if @root.isGM}}{{#if owned}}<button class="x" data-action="celRespec" data-seat="{{key}}">REFUND</button>{{/if}}{{/if}}</div>{{/each}}</div><div class="cel-panel parch"><h3>ACTIVE BONUSES</h3><ul class="bonuses">{{#each bonuses}}<li>{{this}}</li>{{/each}}</ul></div>{{/if}}
{{#if tabs.places}}{{#if isGM}}<div class="cel-drop" data-kind="Scene" data-target="place">⬇ Drop Scene (multi-level becomes a building)</div>{{/if}}<div class="cel-grid">{{#each places}}{{#if hasFloors}}<div class="building"><div class="roof"><span class="chimney">⚙</span></div><div class="bhead"><div class="thumb sm" style="background-image:url('{{img}}')"></div><div><h4>{{name}}</h4><small>{{totals.active}}/{{totals.floorCount}} floors · upkeep {{totals.upkeep}} · bonus {{totals.bonus}}</small></div></div>{{#each floors}}<div class="floor"><b>{{name}}</b><span>{{type}}</span><span>upkeep {{upkeep}}</span><span>bonus {{bonus}}</span><input type="checkbox" data-edit="floor" data-place="{{../id}}" data-id="{{id}}" data-field="active" {{checked active}} {{#unless @root.isGM}}disabled{{/unless}}>{{#if @root.isGM}}<button data-action="celVisitFloor" data-uuid="{{../uuid}}" data-level="{{levelId}}">VISIT</button>{{/if}}</div>{{/each}}{{#if @root.isGM}}<button data-action="celAddFloor" data-id="{{id}}">＋ FLOOR</button><button data-action="celSyncFloors" data-id="{{id}}">SYNC</button>{{/if}}</div>{{else}}<div class="cel-card place"><div class="thumb" style="background-image:url('{{img}}')"></div><h4>{{name}}</h4><p>Upkeep {{upkeep}} · Bonus {{bonus}}</p>{{#if @root.isGM}}<button data-action="celOpenScene" data-uuid="{{uuid}}">VISIT</button><button data-action="celAddFloor" data-id="{{id}}">＋ FLOOR</button><button class="x" data-action="celRemove" data-list="places" data-id="{{id}}">REMOVE</button>{{/if}}</div>{{/if}}{{else}}<p>No workshops.</p>{{/each}}</div>{{/if}}
{{#if tabs.routes}}<div class="cel-panel parch"><h3>MARKET BOARD</h3><div class="market">{{#each market}}<div class="chip {{cls}}">{{label}} <b>{{arrow}} {{pct}}%</b></div>{{/each}}</div></div>{{#if isGM}}<div class="cel-drop" data-kind="Scene" data-target="route">⬇ Drag Scene to add a destination</div><button data-action="celAddRoute">＋ ADD ROUTE</button>{{/if}}<div class="cel-routes">{{#each routes}}<div class="route {{stateCls}}"><div class="rtop"><b class="rname">{{name}}</b><span class="rstate">{{status}}</span></div><div class="lane"><span>{{from}}</span><div class="rail"><span class="cart">{{icon}}</span></div><span>{{to}}</span></div><div class="rstats"><span>{{good}}</span><span>{{mode}}</span><span>TN {{tn}}</span><span>Odds {{oddsPct}}%</span><span>Expected {{expectedNet}}</span></div></div>{{else}}<p>No routes.</p>{{/each}}</div>{{/if}}
{{#if tabs.contracts}}<div class="cel-panel parch"><h3>CLIENT REPUTATION · {{repTier}} · {{reputation}}/100</h3></div>{{#if isGM}}<div class="cel-drop" data-kind="Actor" data-target="contract">⬇ Drag NPC as client</div><button data-action="celRollOffer">NEW OFFER</button><button data-action="celCustomContract">CUSTOM</button>{{/if}}<div class="cel-routes">{{#each contracts}}<div class="contract active"><h4>{{title}}</h4><p>{{client}} · {{typeLabel}}</p><p>{{progress}}/{{required}} progress · {{months}} months</p><p>Reward {{reward}} · TN {{tn}}</p>{{#if isOffered}}{{#if @root.isGM}}<button data-action="celAcceptContract" data-id="{{id}}">ACCEPT</button>{{/if}}{{/if}}</div>{{else}}<p>No contracts.</p>{{/each}}</div>{{/if}}
{{#if tabs.branches}}<div class="cel-panel parch"><h3>BRANCH OFFICES · PLAYER-RUN SUBSIDIARIES</h3><p class="muted">Income: {{rates.tier}} per tier + {{rates.staff}} per staff. Costs: {{rates.wage}} per staff + {{rates.upkeep}} per tier. Max tier at rank {{state.level}}: {{tierCap}}. Dividends convert at {{dividendRate}} ledger coins to 1 gold; 100 coin reserve.</p><ul class="bonuses">{{#each synergies}}<li>{{this}}</li>{{/each}}</ul></div>{{#if isGM}}<div class="cel-toolbar"><button data-action="celAddBranch">＋ OPEN BRANCH</button><label class="rrun">Default tithe % <input type="number" min="0" max="60" data-edit="business" data-field="branchTithe" value="{{state.branchTithe}}"></label><label class="rrun">Coins / gold <input type="number" min="1" max="100" data-edit="business" data-field="dividendRate" value="{{dividendRate}}"></label></div>{{/if}}<div class="cel-note">HQ branch tithe projection: <b class="pos">+{{f.branchInc}}</b></div><div class="cel-routes">{{#each branches}}<div class="branch {{#if mine}}mine{{/if}}"><div class="chead"><div class="cportrait">🏢</div><div class="ctitle"><b class="rname">{{name}}</b><small>{{ownerName}} · {{focusIcon}} {{focusLabel}} {{#if mine}}· YOUR BRANCH{{/if}}</small></div><span class="rstate">TIER {{tier}} / {{tierCap}}</span></div><div class="rstats"><span>Treasury <b>{{cash}}</b></span><span>Staff {{staff}}/{{hireCap}}</span><span>Morale {{morale}}%</span><span>Income {{gross}}</span><span>Costs {{costs}}</span><span>Profit {{profit}}</span><span>HQ tithe {{tithe}} ({{tithe_pct}}%)</span><span>Kept {{keep}}</span><span>Growth {{growth}}/{{need}}</span></div><p class="muted">{{focusSyn}}</p>{{#if canAct}}<div class="ccrew">{{#each stances}}<button class="stancebtn {{#if on}}on{{/if}}" data-action="celBranchStance" data-id="{{../id}}" data-stance="{{key}}">{{icon}} {{label}}</button>{{/each}}<button data-action="celBranchHire" data-id="{{id}}" {{#unless canHire}}disabled{{/unless}}>HIRE ({{@root.hireCost}})</button><button data-action="celBranchUpgrade" data-id="{{id}}" {{#unless canUpgrade}}disabled{{/unless}}>UPGRADE ({{upCost}})</button><button data-action="celBranchDividend" data-id="{{id}}" {{#unless goldMax}}disabled{{/unless}}>DIVIDEND ({{goldMax}} gold)</button></div>{{/if}}{{#if @root.isGM}}<div class="rgrid c4"><label>Focus<select data-edit="branches" data-id="{{id}}" data-field="focus">{{selectOptions @root.branchFocusChoices selected=focus}}</select></label><label>Tier<input type="number" data-edit="branches" data-id="{{id}}" data-field="tier" value="{{tier}}"></label><label>Staff<input type="number" data-edit="branches" data-id="{{id}}" data-field="staff" value="{{staff}}"></label><label>Cash<input type="number" data-edit="branches" data-id="{{id}}" data-field="cash" value="{{cash}}"></label><label>Tithe<input type="number" data-edit="branches" data-id="{{id}}" data-field="tithe" value="{{tithe_pct}}"></label><label>Morale<input type="number" data-edit="branches" data-id="{{id}}" data-field="morale" value="{{morale}}"></label></div><div class="cel-drop sm" data-kind="Scene" data-target="branch" data-id="{{id}}">⬇ Drop a Scene for this branch</div><button class="x" data-action="celRemove" data-list="branches" data-id="{{id}}">CLOSE BRANCH</button>{{/if}}</div>{{else}}<p>No branches yet.</p>{{/each}}</div>{{/if}}
{{#if tabs.spies}}<div class="cel-panel parch"><h3>COUNTER-INTELLIGENCE · HEAT {{heat}} · DEFENCE {{def.total}}</h3><div class="repbar heatbar {{heatCls}}"><div class="fill" style="width:{{heat}}%"></div><span>{{heat}}%</span></div></div>{{#if isGM}}<div class="cel-drop" data-kind="Actor" data-target="rival">⬇ Drag NPC as rival</div><button data-action="celAddRival">＋ ADD RIVAL</button>{{/if}}<div class="cel-routes">{{#each rivals}}<div class="rival"><h4>{{name}}</h4><p>Strength {{strength}} · Secrecy {{secrecy}} · Aggression {{aggression}} · Intel {{intel}} · Drag {{drag}}</p><p>NEXT: {{planText}}</p>{{#if @root.isGM}}<button data-action="celAddOp" data-rival="{{id}}">＋ OPERATION</button>{{/if}}{{#each ops}}<p>{{kind}} · TN {{tn}} · odds {{oddsPct}}%</p>{{/each}}</div>{{else}}<p>No rivals.</p>{{/each}}</div>{{/if}}
{{#if tabs.deals}}<div class="cel-panel parch"><h3>TAKEOVERS &amp; MERGERS</h3><p class="muted">Make offers to rivals; divisions integrate over time.</p></div><div class="cel-panel"><h3>DIVISIONS · net {{f.divNet}}</h3>{{#each divisions}}<div class="division"><h4>{{name}} · {{integration}}% integrated</h4><p>Income {{income}} · upkeep {{upkeep}} · net {{net}}</p>{{#if @root.isGM}}<label>Division head<select data-edit="divhead" data-id="{{id}}">{{selectOptions headChoices selected=headId}}</select></label><button data-action="celDivest" data-id="{{id}}">SELL {{divestValue}}</button>{{/if}}</div>{{else}}<p>No divisions.</p>{{/each}}</div><div class="cel-routes">{{#each deals}}<div class="deal"><h4>{{name}} · strength {{strength}} · intel {{intel}}</h4><div class="dealopts"><div class="dealbox"><h5>TAKEOVER</h5><p>{{buyout.price}} · odds {{buyout.oddsPct}}% · TN {{buyout.tn}}</p>{{#if @root.isGM}}<button data-action="celDeal" data-rival="{{id}}" data-kind="buyout" {{#if buyout.blocked}}disabled{{/if}}>OFFER</button>{{/if}}</div><div class="dealbox"><h5>MERGER</h5><p>{{merger.price}} · odds {{merger.oddsPct}}% · TN {{merger.tn}}</p>{{#if @root.isGM}}<button data-action="celDeal" data-rival="{{id}}" data-kind="merger" {{#if merger.blocked}}disabled{{/if}}>PROPOSE</button>{{/if}}</div></div></div>{{else}}<p>No acquisition targets.</p>{{/each}}</div>{{/if}}
{{#if tabs.events}}{{#if isGM}}<div class="cel-toolbar"><button data-action="celRollEvent" data-kind="internal">INTERNAL</button><button data-action="celRollEvent" data-kind="external">EXTERNAL</button><button data-action="celRollEvent" data-kind="any">ANY</button><button data-action="celCustomEvent">CUSTOM</button></div>{{/if}}<div class="cel-grid wide">{{#each events}}<div class="cel-card ev {{kind}} {{#if threat}}threat{{else}}boon{{/if}}"><h4>{{title}}</h4><p>{{desc}}</p><p>Income {{impact}} · Morale {{mor}} · {{duration}}</p>{{#if @root.isGM}}{{#if threat}}<button data-action="celResolveEvent" data-id="{{id}}">RESOLVE</button>{{/if}}<button class="x" data-action="celRemove" data-list="events" data-id="{{id}}">DISMISS</button>{{/if}}</div>{{else}}<p>All quiet.</p>{{/each}}</div>{{/if}}
{{#if tabs.trophies}}<div class="cel-panel parch"><h3>TROPHIES {{trophyCount}}/{{trophyTotal}}</h3><div class="cel-trophies">{{#each trophies}}<div class="trophy {{#if got}}got{{else}}locked{{/if}}"><div class="medal">{{#if got}}{{icon}}{{else}}🔒{{/if}}</div><h4>{{title}}</h4><p>{{desc}}</p></div>{{/each}}</div></div>{{/if}}
</section></div>