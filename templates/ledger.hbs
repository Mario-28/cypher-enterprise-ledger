<header class="cel-header {{#if banner}}has-banner{{/if}}" {{#if banner}}style="--banner:url('{{banner}}')"{{/if}}>
<svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs><symbol id="celgear" viewBox="0 0 100 100"><g fill="#c9a24a"><circle cx="50" cy="50" r="30"/><rect x="44" y="8" width="12" height="16" rx="3"/><rect x="44" y="8" width="12" height="16" rx="3" transform="rotate(45 50 50)"/><rect x="44" y="8" width="12" height="16" rx="3" transform="rotate(90 50 50)"/><rect x="44" y="8" width="12" height="16" rx="3" transform="rotate(135 50 50)"/><rect x="44" y="8" width="12" height="16" rx="3" transform="rotate(180 50 50)"/><rect x="44" y="8" width="12" height="16" rx="3" transform="rotate(225 50 50)"/><rect x="44" y="8" width="12" height="16" rx="3" transform="rotate(270 50 50)"/><rect x="44" y="8" width="12" height="16" rx="3" transform="rotate(315 50 50)"/><circle cx="50" cy="50" r="12" fill="#23160e"/></g></symbol></defs></svg>
<svg class="crest-deco" viewBox="0 0 250 118" aria-hidden="true"><defs><linearGradient id="celbrass" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#f2d58b"/><stop offset=".5" stop-color="#c9a24a"/><stop offset="1" stop-color="#6b4a1e"/></linearGradient><linearGradient id="celteal" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#aef7ea"/><stop offset=".55" stop-color="#46d7c1"/><stop offset="1" stop-color="#1d6e60"/></linearGradient></defs><path d="M28 88 Q125 62 222 88" fill="none" stroke="url(#celbrass)" stroke-width="7" stroke-linecap="round"/><path d="M45 100 Q125 78 205 100" fill="none" stroke="url(#celbrass)" stroke-width="4" stroke-linecap="round" opacity=".8"/><use href="#celgear" x="14" y="26" width="36" height="36" opacity=".75"/><use href="#celgear" x="200" y="26" width="36" height="36" opacity=".75"/><polygon points="72,42 84,62 72,82 60,62" fill="url(#celteal)"/><polygon points="178,42 190,62 178,82 166,62" fill="url(#celteal)"/><polygon points="125,6 150,44 125,72 100,44" fill="url(#celteal)"/><polygon points="125,6 150,44 125,44" fill="#eafffb" opacity=".45"/><polygon points="125,6 100,44 125,44" fill="#0f4a40" opacity=".35"/><path d="M96 84 L125 70 L154 84" fill="none" stroke="url(#celbrass)" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/><path d="M104 96 L125 86 L146 96" fill="none" stroke="url(#celbrass)" stroke-width="4" stroke-linecap="round" opacity=".75"/></svg>
<svg class="gear-deco" viewBox="0 0 100 100" aria-hidden="true"><use href="#celgear"/></svg><svg class="gear-deco right" viewBox="0 0 100 100" aria-hidden="true"><use href="#celgear"/></svg>
<div class="nameplate"><span class="crystal"></span><div class="cel-logo">{{#if isGM}}<input class="cel-title-in" data-edit="business" data-field="name" value="{{state.name}}">{{else}}<span>{{state.name}}</span>{{/if}}</div></div>
<div class="cel-badges"><span class="coin rank"><small>RANK</small>{{#if isGM}}<input type="number" min="1" max="10" data-edit="business" data-field="level" value="{{state.level}}">{{else}}<b>{{state.level}}</b>{{/if}}</span><span class="coin rep"><small>{{repTier}}</small><b data-count="{{reputation}}" data-ck="rep">{{reputation}}</b></span><span class="coin perk"><small>PERKS</small><b data-count="{{pp.left}}" data-ck="perks">{{pp.left}}</b></span><span class="coin heat {{heatCls}}"><small>HEAT</small><b data-count="{{heat}}" data-ck="heat">{{heat}}</b></span><span class="coin month"><small>MONTH</small><b data-count="{{state.month}}" data-ck="month">{{state.month}}</b></span><span class="coin cash"><small>TREASURY</small>{{#if isGM}}<input type="number" data-edit="business" data-field="cash" value="{{state.cash}}">{{else}}<b data-count="{{state.cash}}" data-ck="cash">{{state.cash}}</b>{{/if}}</span><button type="button" class="cel-set-btn" data-action="celSettings" title="Ledger settings"><svg class="ico"><use href="#i-gear"/></svg></button></div></header>
<nav class="cel-tabs"><button type="button" data-action="celShowTab" data-tab="overview" class="{{#if tabs.overview}}active{{/if}} "><svg class="ico"><use href="#i-book"/></svg><span>COUNTING HOUSE</span></button>
<button type="button" data-action="celShowTab" data-tab="tasks" class="{{#if tabs.tasks}}active{{/if}} {{#if canAct}}todo{{/if}}"><svg class="ico"><use href="#i-task"/></svg><span>TASKS {{tasks.length}}</span></button>
<button type="button" data-action="celShowTab" data-tab="staff" class="{{#if tabs.staff}}active{{/if}} "><svg class="ico"><use href="#i-crew"/></svg><span>CREW {{staff.length}}</span></button>
<button type="button" data-action="celShowTab" data-tab="duty" class="{{#if tabs.duty}}active{{/if}} "><svg class="ico"><use href="#i-task"/></svg><span>PC DUTY {{pcs.length}}</span></button>
<button type="button" data-action="celShowTab" data-tab="execs" class="{{#if tabs.execs}}active{{/if}} "><svg class="ico"><use href="#i-crown"/></svg><span>BOARDROOM</span></button>
<button type="button" data-action="celShowTab" data-tab="places" class="{{#if tabs.places}}active{{/if}} "><svg class="ico"><use href="#i-gear"/></svg><span>WORKSHOPS {{places.length}}</span></button>
<button type="button" data-action="celShowTab" data-tab="routes" class="{{#if tabs.routes}}active{{/if}} "><svg class="ico"><use href="#i-train"/></svg><span>TRADE {{routes.length}}</span></button>
<button type="button" data-action="celShowTab" data-tab="contracts" class="{{#if tabs.contracts}}active{{/if}} "><svg class="ico"><use href="#i-scroll"/></svg><span>CONTRACTS {{activeCount}}</span></button>
<button type="button" data-action="celShowTab" data-tab="branches" class="{{#if tabs.branches}}active{{/if}} "><svg class="ico"><use href="#i-home"/></svg><span>BRANCHES {{branches.length}}</span></button>
<button type="button" data-action="celShowTab" data-tab="spies" class="{{#if tabs.spies}}active{{/if}} "><svg class="ico"><use href="#i-eye"/></svg><span>INTRIGUE {{rivals.length}}</span></button>
<button type="button" data-action="celShowTab" data-tab="deals" class="{{#if tabs.deals}}active{{/if}} "><svg class="ico"><use href="#i-scale"/></svg><span>DEALS {{divisions.length}}</span></button>
<button type="button" data-action="celShowTab" data-tab="events" class="{{#if tabs.events}}active{{/if}} {{#if threats}}alert{{/if}}"><svg class="ico"><use href="#i-bolt"/></svg><span>EVENTS {{events.length}}</span></button>
<button type="button" data-action="celShowTab" data-tab="trophies" class="{{#if tabs.trophies}}active{{/if}} "><svg class="ico"><use href="#i-cup"/></svg><span>TROPHIES {{trophyCount}}/{{trophyTotal}}</span></button></nav>
<section class="cel-body">
{{#if tabs.overview}}
{{#if threats}}<div class="cel-alert">⚠ {{threats}} active threats · impact <b>{{f.evInc}}</b></div>{{/if}}
<div class="gauges">{{#each gauges}}<div class="gauge-card {{cls}}"><svg viewBox="0 0 100 64" class="dial"><path class="track" d="M10 54 A40 40 0 0 1 90 54"/><path class="arc" d="M10 54 A40 40 0 0 1 90 54" style="--arc:{{arc}}"/><g class="ticks"><line x1="50" y1="15" x2="50" y2="21" transform="rotate(-90 50 54)"/><line x1="50" y1="15" x2="50" y2="21" transform="rotate(-60 50 54)"/><line x1="50" y1="15" x2="50" y2="21" transform="rotate(-30 50 54)"/><line x1="50" y1="15" x2="50" y2="21"/><line x1="50" y1="15" x2="50" y2="21" transform="rotate(30 50 54)"/><line x1="50" y1="15" x2="50" y2="21" transform="rotate(60 50 54)"/><line x1="50" y1="15" x2="50" y2="21" transform="rotate(90 50 54)"/></g><g class="needle" style="--ang:{{angle}}deg"><line x1="50" y1="54" x2="50" y2="22"/><circle cx="50" cy="54" r="4.5"/></g></svg><label>{{label}}</label><b data-count="{{value}}" data-ck="gauge-{{key}}">{{value}}</b><small>{{sub}}</small></div>{{/each}}</div>
<div class="notes">{{#if routes.length}}<div class="cel-note">🚂 {{runningRoutes}} routes · expected route net <b>{{f.routeNet}}</b></div>{{/if}}{{#if activeCount}}<div class="cel-note">📜 {{activeCount}} active contracts.</div>{{/if}}{{#if branches.length}}<div class="cel-note">🏢 Branch tithes to HQ: <b class="pos">+{{f.branchInc}}</b></div>{{/if}}</div>
<div class="cel-panel parch"><h3>PROFIT TREND</h3>{{#if graph}}<svg viewBox="0 0 {{graph.W}} {{graph.H}}" class="cel-graph"><line x1="0" x2="{{graph.W}}" y1="{{graph.zero}}" y2="{{graph.zero}}" class="zero"/><polyline points="{{graph.line}}" class="glow"/><polygon class="area" points="{{graph.line}} {{graph.W}},{{graph.zero}} 0,{{graph.zero}}"/><polyline points="{{graph.line}}" class="ln"/>{{#each graph.pts}}<circle cx="{{x}}" cy="{{y}}" r="4"/><text x="{{x}}" y="147" class="tick">{{m}}</text>{{/each}}</svg>{{else}}<p class="muted">Close two months to see the trend.</p>{{/if}}</div>
<div class="cel-panel parch"><h3>LEDGER</h3>{{#if history.length}}<table class="cel-table"><thead><tr><th>Month</th><th>Income</th><th>Costs</th><th>Profit</th></tr></thead><tbody>{{#each history}}<tr><td>{{month}}</td><td>{{income}}</td><td>{{costs}}</td><td class="{{#if (gte profit 0)}}pos{{else}}neg{{/if}}">{{profit}}</td></tr>{{/each}}</tbody></table>{{else}}<p class="muted">No months closed yet.</p>{{/if}}</div>
{{#if isGM}}<button type="button" class="cel-big" data-action="celCloseMonth"><span class="est">EST. 1899</span><span class="plate-txt">CLOSE<br>THE MONTH</span><span class="seal"></span></button><div class="cel-panel tools"><h3>TOOLS · V{{version}} · SCHEMA {{schema}}</h3><div class="cel-toolbar"><button data-action="celSelfTest">🩺 SELF-TEST</button><button data-action="celExport">💾 BACKUP</button><button data-action="celImport">📥 RESTORE</button><button class="x" data-action="celReset">⚠ RESET</button></div><p class="muted">Self-test uses dummy data; it never changes this ledger. Header banner image is set in module settings.</p></div>{{/if}}
{{/if}}
{{#if tabs.tasks}}<div class="cel-panel parch"><h3>YOUR TASK THIS MONTH</h3>{{#if canAct}}<div class="cel-form"><label>Task<select name="task">{{#each taskDefs}}<option value="{{key}}">{{label}}</option>{{/each}}</select></label><label>Target<select name="target"><option value="">— select if needed —</option><optgroup label="Threats">{{#each targetThreats}}<option value="{{id}}">{{label}}</option>{{/each}}</optgroup><optgroup label="Routes">{{#each targetRoutes}}<option value="{{id}}">{{label}}</option>{{/each}}</optgroup><optgroup label="Contracts">{{#each targetContracts}}<option value="{{id}}">{{label}}</option>{{/each}}</optgroup><optgroup label="Rivals">{{#each targetRivals}}<option value="{{id}}">{{label}}</option>{{/each}}</optgroup><optgroup label="Divisions">{{#each targetDivisions}}<option value="{{id}}">{{label}}</option>{{/each}}</optgroup><optgroup label="Branches">{{#each targetBranches}}<option value="{{id}}">{{label}}</option>{{/each}}</optgroup></select></label><label>Asset / skill steps<input name="steps" type="number" min="0" max="3" value="0"></label><button class="cel-big small" data-action="celDoTask">🎲 PERFORM TASK</button></div>{{else}}<p>You have already acted this month.</p>{{/if}}</div><div class="cel-grid wide">{{#each tasks}}<div class="cel-card ev"><h4>{{label}}</h4><p>{{who}} · {{userName}}</p><p>Roll {{total}} vs {{tn}} · {{#if success}}<b class="pos">SUCCESS</b>{{else}}<b class="neg">FAILED</b>{{/if}}</p><p>{{text}}</p>{{#if @root.isGM}}<button class="x" data-action="celRemove" data-list="tasks" data-id="{{id}}">UNDO / RETRY</button>{{/if}}</div>{{else}}<p>No tasks yet.</p>{{/each}}</div>{{/if}}
{{#if tabs.staff}}{{#if isGM}}<div class="cel-drop" data-kind="Actor" data-target="staff">⬇ Drag NPC here to hire</div>{{/if}}<div class="cel-grid">{{#each staff}}<div class="cel-card"><div class="ring" style="--pct:{{happiness}}"><img src="{{img}}"><span class="mood">{{mood}}</span></div><h4>{{name}}</h4><label>Role<input data-edit="staff" data-id="{{id}}" data-field="role" value="{{role}}" {{#unless @root.isGM}}disabled{{/unless}}></label><label>Specialty<select data-edit="staff" data-id="{{id}}" data-field="spec" {{#unless @root.isGM}}disabled{{/unless}}>{{selectOptions @root.specChoices selected=spec}}</select></label><label>Wage<input type="number" data-edit="staff" data-id="{{id}}" data-field="wage" value="{{wage}}" {{#unless @root.isGM}}disabled{{/unless}}></label><label>Morale<input type="number" data-edit="staff" data-id="{{id}}" data-field="happiness" value="{{happiness}}" {{#unless @root.isGM}}disabled{{/unless}}></label>{{#if @root.isGM}}<button class="x" data-action="celRemove" data-list="staff" data-id="{{id}}">DISMISS</button>{{/if}}</div>{{else}}<p>No crew.</p>{{/each}}</div>{{/if}}
{{#if tabs.duty}}{{#if isGM}}<div class="cel-drop" data-kind="Actor" data-target="pc">⬇ Drag a PC actor onto the ledger</div>{{/if}}<div class="cel-panel parch"><h3>WEEK {{week}} · WEEKLY DUTY</h3><p class="muted">Assign each PC a duty, then close the week. Roll: d20 + role + sheet skill + tuning vs TN. A 20 doubles the effect; a 1 means a complication (heat +2). Tokens last until the month closes.</p>{{#if momentum.production}}<p>⚙ Production tokens {{momentum.production}} (+{{momIncome}} income next month) · 🚂 Trade tokens {{momentum.trade}} (+{{momentum.trade}} per route)</p>{{/if}}<p class="muted">{{#each taskCatalog}}{{icon}} {{label}} (TN {{tn}}): {{desc}} {{/each}}</p></div><div class="cel-grid">{{#each pcs}}<div class="cel-card"><div class="thumb" style="background-image:url('{{img}}')"></div><h4>{{name}}</h4><p>{{roleIcon}} {{roleLabel}}{{#if domains}} — good at {{#each domains}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}{{/if}}</p><p>{{taskIcon}} {{taskLabel}}{{#if taskTn}} (TN {{taskTn}}){{/if}} — {{taskDesc}}</p>{{#if @root.isGM}}<div class="rgrid c4"><label>Role<select data-edit="pcs" data-id="{{id}}" data-field="role">{{selectOptions @root.pcRoleChoices selected=role}}</select></label><label>Duty<select data-edit="pcs" data-id="{{id}}" data-field="task">{{selectOptions @root.pcTaskChoices selected=task}}</select></label><label>Tuning ±<input type="number" min="-2" max="2" data-edit="pcs" data-id="{{id}}" data-field="adj" value="{{adj}}"></label></div><button class="x" data-action="celRemove" data-list="pcs" data-id="{{id}}">REMOVE</button>{{/if}}</div>{{else}}<div class="cel-panel parch"><p>No PCs on the ledger yet.{{#if isGM}} Drag a character actor above.{{/if}}</p></div>{{/each}}</div>{{#if isGM}}<div class="bfoot"><button data-action="celResolveWeek">⚙ CLOSE WEEK {{week}} & ROLL DUTIES</button></div>{{/if}}{{#if weekLog}}<div class="cel-panel parch"><h3>WEEK LOG</h3>{{#each weekLog}}<p class="muted">W{{wk}} · {{icon}} {{name}} — {{task}}: d20 {{nat}}{{#if bonus}} +{{bonus}} = {{total}}{{/if}} vs TN {{tn}} — <b>{{outcome}}</b>{{#if detail}} · {{detail}}{{/if}}</p>{{/each}}</div>{{/if}}{{/if}}
{{#if tabs.execs}}<div class="cel-panel parch"><h3>BOARDROOM · {{pp.left}} PERK POINTS</h3><p class="muted">Assign executives; tiers cost 1, 2, 3. Salary {{salary}} monthly each.</p></div><div class="seats">{{#each seats}}<div class="seat {{#if vacant}}vacant{{/if}} {{#if dormant}}dormant{{/if}}"><div class="plate">{{icon}} {{title}}</div><div class="sbody">{{#if exec}}<div class="ring" style="--pct:{{exec.happiness}}"><img src="{{exec.img}}"><span>{{exec.mood}}</span></div><b>{{exec.name}}</b>{{else}}🪑 Vacant{{/if}}<select data-edit="exec" data-field="{{key}}" {{#unless @root.isGM}}disabled{{/unless}}>{{selectOptions assignChoices selected=current}}</select></div><div class="rungs">{{#each tiers}}<div class="rung {{#if isOwned}}owned{{/if}} {{#if live}}live{{/if}} {{#if locked}}locked{{/if}}"><span class="tier">{{tier}}</span><div class="rtext"><b>{{name}}</b><small>{{desc}}</small></div>{{#if isOwned}}✔{{else}}{{#if buyable}}{{#if @root.isGM}}<button data-action="celBuyPerk" data-seat="{{../key}}" data-tier="{{tier}}">BUY {{cost}}</button>{{else}}{{cost}} pt{{/if}}{{else}}{{cost}} pt{{/if}}{{/if}}</div>{{/each}}</div>{{#if @root.isGM}}{{#if owned}}<button class="x" data-action="celRespec" data-seat="{{key}}">REFUND</button>{{/if}}{{/if}}</div>{{/each}}</div><div class="cel-panel parch"><h3>ACTIVE BONUSES</h3><ul class="bonuses">{{#each bonuses}}<li>{{this}}</li>{{/each}}</ul></div>{{/if}}
{{#if tabs.places}}{{#if isGM}}<div class="cel-drop" data-kind="Scene" data-target="place">⬇ Drop Scene (multi-level becomes a building)</div>{{/if}}<div class="cel-grid">{{#each places}}{{#if hasFloors}}<div class="building"><div class="roof"><span class="chimney">⚙</span></div><div class="bhead"><div class="thumb sm" style="background-image:url('{{img}}')"></div><div><h4>{{name}}</h4><small>{{totals.active}}/{{totals.floorCount}} floors · upkeep {{totals.upkeep}} · bonus {{totals.bonus}}</small></div></div>{{#each floors}}<div class="floor">{{#if @root.isGM}}<input data-edit="floor" data-place="{{../id}}" data-id="{{id}}" data-field="name" value="{{name}}"><select data-edit="floor" data-place="{{../id}}" data-id="{{id}}" data-field="type">{{selectOptions @root.floorTypes selected=type}}</select><input type="number" data-edit="floor" data-place="{{../id}}" data-id="{{id}}" data-field="upkeep" value="{{upkeep}}"><input type="number" data-edit="floor" data-place="{{../id}}" data-id="{{id}}" data-field="bonus" value="{{bonus}}"><input type="checkbox" data-edit="floor" data-place="{{../id}}" data-id="{{id}}" data-field="active" {{checked active}}><button data-action="celVisitFloor" data-uuid="{{../uuid}}" data-level="{{levelId}}">VISIT</button><button class="x" data-action="celRemoveFloor" data-place="{{../id}}" data-id="{{id}}">✕</button>{{else}}<b>{{name}}</b><span>{{type}}</span><span>upkeep {{upkeep}}</span><span>bonus {{bonus}}</span><input type="checkbox" data-edit="floor" data-place="{{../id}}" data-id="{{id}}" data-field="active" {{checked active}} disabled>{{/if}}</div>{{/each}}{{#if @root.isGM}}<button data-action="celAddFloor" data-id="{{id}}">＋ FLOOR</button><button data-action="celSyncFloors" data-id="{{id}}">SYNC</button>{{/if}}</div>{{else}}<div class="cel-card place"><div class="thumb" style="background-image:url('{{img}}')"></div><h4>{{name}}</h4>{{#if @root.isGM}}<div class="rgrid c4"><label>Upkeep<input type="number" data-edit="places" data-id="{{id}}" data-field="upkeep" value="{{upkeep}}"></label><label>Bonus<input type="number" data-edit="places" data-id="{{id}}" data-field="bonus" value="{{bonus}}"></label></div><button data-action="celOpenScene" data-uuid="{{uuid}}">VISIT</button><button data-action="celAddFloor" data-id="{{id}}">＋ FLOOR</button><button class="x" data-action="celRemove" data-list="places" data-id="{{id}}">REMOVE</button>{{else}}<p>Upkeep {{upkeep}} · Bonus {{bonus}}</p>{{/if}}</div>{{/if}}{{else}}<p>No workshops.</p>{{/each}}</div>{{/if}}
{{#if tabs.routes}}<div class="cel-panel parch"><h3>MARKET BOARD</h3><div class="market">{{#each market}}<div class="chip {{cls}}">{{label}} <b>{{arrow}} {{pct}}%</b></div>{{/each}}</div></div>{{#if isGM}}<div class="cel-drop" data-kind="Scene" data-target="route">⬇ Drag Scene to add a destination</div><button data-action="celAddRoute">＋ ADD ROUTE</button>{{/if}}<div class="cel-routes">{{#each routes}}<div class="route {{stateCls}}"><div class="rtop"><b class="rname">{{name}}</b><span class="rstate">{{status}}</span></div><div class="lane"><span>{{from}}</span><div class="rail"><span class="cart">{{icon}}</span></div><span>{{to}}</span></div><div class="rstats"><span>{{good}}</span><span>{{mode}}</span><span>TN {{tn}}</span><span>Odds {{oddsPct}}%</span><span>Expected {{expectedNet}}</span></div>{{#if @root.isGM}}<div class="rgrid c4"><label>Name<input data-edit="routes" data-id="{{id}}" data-field="name" value="{{name}}"></label><label>From<input data-edit="routes" data-id="{{id}}" data-field="from" value="{{from}}"></label><label>To<input data-edit="routes" data-id="{{id}}" data-field="to" value="{{to}}"></label><label>Good<select data-edit="routes" data-id="{{id}}" data-field="good">{{selectOptions @root.goodChoices selected=good}}</select></label><label>Mode<select data-edit="routes" data-id="{{id}}" data-field="mode">{{selectOptions @root.modeChoices selected=mode}}</select></label><label>Legs<input type="number" min="1" max="5" data-edit="routes" data-id="{{id}}" data-field="legs" value="{{legs}}"></label><label>Cargo<input type="number" min="0" data-edit="routes" data-id="{{id}}" data-field="cargo" value="{{cargo}}"></label><label>Risk mod<input type="number" min="-3" max="3" data-edit="routes" data-id="{{id}}" data-field="riskMod" value="{{riskMod}}"></label><label>Route master<select data-edit="routes" data-id="{{id}}" data-field="master">{{selectOptions @root.crewChoices selected=master}}</select></label></div><div class="rtop"><label><input type="checkbox